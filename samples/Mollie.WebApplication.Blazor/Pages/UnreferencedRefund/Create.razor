@page "/unreferenced-refund/create"
@using Mollie.WebApplication.Blazor.Models.UnreferencedRefund
@using Mollie.Api.Client
@using Mollie.Api.Models.List.Response
@using Mollie.Api.Models.Terminal.Response
@using Mollie.Api.Models.UnreferencedRefund.Request

@inject ITerminalClient TerminalClient
@inject NavigationManager NavigationManager

<h3>Create new unreferenced refund</h3>

<div class="alert alert-info">
    <p>
        An unreferenced refund is a refund that is not linked to a payment. The refund is created on a point-of-sale terminal,
        and the customer receives the refund by presenting their card on the terminal.
    </p>
</div>

<ApiExceptionDisplay Exception="_apiException"></ApiExceptionDisplay>

<EditForm Model="_model" OnValidSubmit="@OnSave" class="col-md-6">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="terminal">Terminal</label>
        <InputSelect
            id="terminal"
            class="form-control"
            @bind-Value="_model.TerminalId">
            <option value="">Select a terminal</option>
            @if (_terminals != null) {
                @foreach (TerminalResponse terminal in _terminals.Items) {
                    <option value="@terminal.Id">@terminal.Id - @terminal.Description</option>
                }
            }
        </InputSelect>
    </div>

    <div class="form-group">
        <label for="amount">Amount</label>
        <InputNumber
            id="amount"
            class="form-control"
            @bind-Value="_model.Amount">
        </InputNumber>
    </div>

    <div class="form-group">
        <label for="currency">Currency</label>
        <InputSelect
            id="currency"
            class="form-control"
            @bind-Value="_model.Currency">
            @foreach (string currency in StaticStringListBuilder.GetStaticStringList(typeof(Currency))) {
                <option value="@currency">@currency</option>
            }
        </InputSelect>
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <InputText
            id="description"
            class="form-control"
            @bind-Value="_model.Description">
        </InputText>
    </div>

    <div class="form-group">
        <label for="metadata">Metadata</label>
        <InputText
            id="metadata"
            class="form-control"
            @bind-Value="_model.Metadata">
        </InputText>
    </div>

    <input type="submit" name="Save" value="Save" class="btn btn-primary mt-2"/>
</EditForm>

@code {
    private MollieApiException? _apiException;

    [Parameter]
    [SupplyParameterFromQuery]
    public string? TerminalId { get; set; }

    private ListResponse<TerminalResponse>? _terminals;

    private CreateUnreferencedRefundModel _model = new() {
        TerminalId = string.Empty,
        Amount = 0.01m,
        Currency = "EUR",
        Description = "An unreferenced refund from the example application",
        Metadata = null
    };

    protected override async Task OnInitializedAsync() {
        _model.TerminalId = TerminalId ?? string.Empty;
        _terminals = await TerminalClient.GetTerminalListAsync();
    }

    private async Task OnSave() {
        try {
            _apiException = null;

            await TerminalClient.CreateUnreferencedRefundAsync(_model.TerminalId, new UnreferencedRefundRequest {
                Amount = new Amount(_model.Currency, _model.Amount),
                Description = _model.Description,
                Metadata = string.IsNullOrWhiteSpace(_model.Metadata) ? null : _model.Metadata
            });

            NavigationManager.NavigateTo("/unreferenced-refund/overview");
        }
        catch (MollieApiException e) {
            _apiException = e;
        }
    }
}
