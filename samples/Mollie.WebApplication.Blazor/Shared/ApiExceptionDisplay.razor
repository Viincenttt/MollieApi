@if (Result is { Success: false }) {
    <div class="alert alert-danger" role="alert">
        A Mollie API error has occured: StatusCode=@Result.HttpStatusCode Title=@Result.Error.Title Detail=@Result.Error.Detail
    </div>
}

@code {
    [Parameter, EditorRequired]
    public MollieResult? Result { get; set; }
}
